# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to Git.

# Kapso WhatsApp API Credentials
# Get these from app.kapso.ai → Settings → API Keys
KAPSO_API_KEY=your_kapso_api_key_here
KAPSO_PHONE_NUMBER_ID=your_kapso_phone_number_id_here

# Groq AI API Key (100% free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Server Port
PORT=3001
